GROQ_API_KEY=
# Optional: additional Groq API keys (different accounts, so each has its
# own separate daily token quota). When the active key hits its daily
# quota (TPD), the app automatically rotates to the next one in order for
# the rest of the day's calls. Leave blank to run with fewer keys.
GROQ_API_KEY_2=
GROQ_API_KEY_3=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Direct Postgres connection (Supabase project settings -> Database -> Connection string),
# used by the job-queue worker for SELECT ... FOR UPDATE SKIP LOCKED polling.
DATABASE_URL=

