GROQ_API_KEY=
# Optional: a second Groq API key (different account, so it has its own
# separate daily token quota). When GROQ_API_KEY hits its daily quota
# (TPD), the app automatically rotates to this key for the rest of the
# day's calls. Leave blank to run with just the one key.
GROQ_API_KEY_2=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Direct Postgres connection (Supabase project settings -> Database -> Connection string),
# used by the job-queue worker for SELECT ... FOR UPDATE SKIP LOCKED polling.
DATABASE_URL=

